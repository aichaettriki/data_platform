{
  "id": null,
  "uid": null,
  "title": "Datalake - Full Stack Monitoring (MinIO / Airflow / Spark / Postgres / Metabase / TF / Catalog)",
    "tags": [
      "datalake",
      "minio",
      "airflow",
      "spark",
      "postgres",
      "metabase",
      "tensorflow",
      "prometheus"
    ],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "type": "row",
        "title": "MinIO (Storage)",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "collapsed": false,
        "id": 1
      },
      {
        "type": "graph",
        "title": "MinIO - Disk Used (bytes) by node",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "minio_cluster_capacity_raw_total_bytes - minio_cluster_capacity_raw_free_bytes",
            "legendFormat": "used_bytes",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 1
        },
        "id": 2
      },
      {
        "type": "graph",
        "title": "MinIO - Bucket Usage Size (bytes)",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "minio_cluster_usage_total_bytes",
            "legendFormat": "total_usage",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 1
        },
        "id": 3
      },
      {
        "type": "graph",
        "title": "MinIO - S3 Request Rate (req/s)",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "rate(minio_audit_total_messages[5m])",
            "legendFormat": "requests",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 9
        },
        "id": 4
      },
      {
        "type": "stat",
        "title": "MinIO - 5m Error Rate (5xx)",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "minio_audit_failed_messages",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 3,
          "w": 12,
          "x": 12,
          "y": 9
        },
        "id": 5
      },
      {
        "type": "row",
        "title": "Airflow (Orchestration & Ingestion)",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 12
        },
        "collapsed": false,
        "id": 6
      },
      {
        "type": "graph",
        "title": "Airflow - DAG Success Rate (1h)",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "100 * (sum(airflow_dag_run_status{status=\"success\"}) / clamp_min(sum(airflow_dag_run_status), 1e-9))",
            "legendFormat": "success_rate_percent",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 13
        },
        "id": 7
      },
      {
        "type": "table",
        "title": "Airflow - Recent DAG Failures (last 24h)",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(airflow_task_status{status=\"failed\"}) by (dag_id)",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 12,
          "y": 13
        },
        "id": 8
      },
      {
        "type": "graph",
        "title": "Airflow - Task Queue Time (avg)",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "avg(airflow_task_duration_seconds)",
            "legendFormat": "avg_duration_s",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 5,
          "w": 12,
          "x": 0,
          "y": 19
        },
        "id": 9
      },
      {
        "type": "stat",
        "title": "Airflow - Running Tasks",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(airflow_task_status{status=\"running\"})",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 5,
          "w": 12,
          "x": 12,
          "y": 19
        },
        "id": 10
      },
      {
        "type": "row",
        "title": "Spark (Transformations)",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 24
        },
        "collapsed": false,
        "id": 11
      },
      {
        "type": "graph",
        "title": "Spark - Jobs Duration (95th percentile)",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(spark_job_duration_seconds_bucket[5m])) by (le))",
