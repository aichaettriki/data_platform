          }
        ],
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 25
        },
        "id": 12
      },
      {
        "type": "graph",
        "title": "Spark - Executor CPU & Memory",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "avg(spark_executor_cpu_seconds_total) by (instance)",
            "legendFormat": "cpu_seconds_total",
            "refId": "A"
          },
          {
            "expr": "avg(spark_executor_memory_bytes) by (instance)",
            "legendFormat": "memory_bytes",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 12,
          "y": 25
        },
        "id": 13
      },
      {
        "type": "graph",
        "title": "Spark - Shuffle Read/Write (bytes/s)",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "rate(spark_shuffle_read_bytes_total[5m])",
            "legendFormat": "shuffle_read_bps",
            "refId": "A"
          },
          {
            "expr": "rate(spark_shuffle_write_bytes_total[5m])",
            "legendFormat": "shuffle_write_bps",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 5,
          "w": 12,
          "x": 0,
          "y": 31
        },
        "id": 14
      },
      {
        "type": "stat",
        "title": "Spark - Executors Active",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(spark_executor_count)",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 5,
          "w": 12,
          "x": 12,
          "y": 31
        },
        "id": 15
      },
      {
        "type": "row",
