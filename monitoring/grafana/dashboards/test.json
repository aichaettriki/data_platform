    "templating": {
      "list": [
        {
          "type": "datasource",
          "name": "DS_PROMETHEUS",
          "label": "Prometheus datasource",
          "query": "prometheus",
          "current": {
            "text": "Prometheus",
            "value": "Prometheus"
          },
          "hide": 0
        },
        {
          "type": "query",
          "name": "bucket",
          "label": "MinIO Bucket",
          "datasource": "${DS_PROMETHEUS}",
          "query": "label_values(minio_bucket_usage_size_bytes, bucket)",
          "refresh": 2,
          "includeAll": true,
          "multi": true,
          "current": {}
        },
        {
          "type": "query",
          "name": "instance",
          "label": "Instance",
          "datasource": "${DS_PROMETHEUS}",
          "query": "label_values(node_cpu_seconds_total, instance)",
          "refresh": 2,
          "includeAll": true,
          "multi": true,
          "current": {}
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "${DS_PROMETHEUS}",
          "iconColor": "rgb(255, 96, 96)",
          "enable": true,
          "expr": "changes(deployment_version[1h])"
        }
      ]
    },
    "links": []
