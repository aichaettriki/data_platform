  "panels": [
    {
      "id": 1,
      "title": "Marquez API Status",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"color": "red","text": "DOWN"}, "1": {"color": "green","text": "UP"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}
        },
        "overrides": []
      },
      "options": {"colorMode":"value","graphMode":"area","reduceOptions":{"calcs":["lastNotNull"],"values":false}}
      ,"targets":[{"expr":"up{job=\"marquez-jmx\"}","refId":"A"}]
    },
    {
      "id": 2,
      "title": "Total Jobs",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos":{"h":6,"w":8,"x":8,"y":0},
      "fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":80}]}}, "overrides":[]},
      "options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false}},
      "targets":[{"expr":"marquez_jobs_total{namespace=\"$namespace\"}","refId":"A"}]
    },
    {
      "id": 3,
      "title": "Total Datasets",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos":{"h":6,"w":8,"x":16,"y":0},
      "fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":80}]}}, "overrides":[]},
      "options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false}},
      "targets":[{"expr":"marquez_datasets_total{namespace=\"$namespace\"}","refId":"A"}]
    },
    {
      "id": 4,
      "title": "Runs Running",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos":{"h":6,"w":8,"x":0,"y":6},
      "fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":10}]}}, "overrides":[]},
      "options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false}},
      "targets":[{"expr":"marquez_runs_running{namespace=\"$namespace\"}","refId":"A"}]
    },
    {
      "id": 5,
      "title": "Runs Completed",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos":{"h":6,"w":8,"x":8,"y":6},
      "fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"red","value":0},{"color":"green","value":null}]}}, "overrides":[]},
      "options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false}},
      "targets":[{"expr":"marquez_runs_completed_total{namespace=\"$namespace\"}","refId":"A"}]
    },
    {
      "id": 6,
      "title": "Runs Failed",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos":{"h":6,"w":8,"x":16,"y":6},
      "fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"red","value":1}]}}, "overrides":[]},
      "options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false}},
      "targets":[{"expr":"marquez_runs_failed_total{namespace=\"$namespace\"}","refId":"A"}]
    },
    {
      "id": 7,
      "title": "Dataset Last Updated (hours ago)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos":{"h":6,"w":8,"x":0,"y":12},
      "fieldConfig":{"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"red","value":48}]}}, "overrides":[]},
      "options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false}},
      "targets":[{"expr":"(time() - marquez_dataset_last_updated_timestamp{namespace=\"$namespace\"}) / 3600","refId":"A"}]
    }
